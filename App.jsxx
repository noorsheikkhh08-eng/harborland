      .badge-row { display: flex; flex-wrap: wrap; gap: 10px; }
      .badge { padding: 8px 14px; border-radius: 999px; border: 1px solid var(--border); color: var(--muted); font-size: 13px; font-family: 'IBM Plex Mono', monospace; }
      .badge.earned { background: linear-gradient(135deg, var(--coral), var(--sunflower)); color: #221A0F; border-color: transparent; font-weight: 600; }
      .calendar-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; font-family: 'IBM Plex Mono', monospace; font-size: 13.5px; color: var(--muted); }
      .calendar-nav button { color: var(--muted); padding: 4px; border-radius: 6px; }
      .calendar-nav button:hover { color: var(--text); }
      .weekday-row { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; color: var(--muted); font-size: 11.5px; margin-bottom: 6px; }
      .day-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }
      .day-cell { aspect-ratio: 1; border-radius: 9px; background: var(--surface-alt); color: var(--text); font-family: 'IBM Plex Mono', monospace; font-size: 12.5px; display: flex; align-items: center; justify-content: center; transition: transform 0.1s; }
      .day-cell.empty { background: transparent; }
      .day-cell:not(.empty):hover { transform: scale(1.08); }
      .day-cell.is-today { box-shadow: 0 0 0 1.5px var(--sunflower) inset; }
      .legend { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
      .legend-item { display: flex; align-items: center; gap: 6px; font-size: 11.5px; color: var(--muted); }
      .legend-dot { width: 8px; height: 8px; border-radius: 50%; }
      .day-panel-backdrop { position: fixed; inset: 0; background: rgba(10,8,20,0.6); display: flex; align-items: center; justify-content: center; padding: 20px; z-index: 40; }
      .day-panel { width: 100%; max-width: 420px; display: flex; flex-direction: column; gap: 14px; }
      .day-panel-head { display: flex; justify-content: space-between; align-items: center; }
      .day-panel-head button { color: var(--muted); }
      .note-label { font-size: 12.5px; color: var(--muted); }
      .note-input { width: 100%; background: var(--surface-alt); border: 1px solid var(--border); border-radius: 12px; color: var(--text); padding: 10px 12px; font-family: inherit; font-size: 13.5px; resize: vertical; }
      .breathing-card, .ripple-card, .bubble-card { display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
      .breathing-card h2, .ripple-card h2, .bubble-card h2 { font-size: 17px; align-self: flex-start; }
      .pacer { width: 160px; height: 160px; border-radius: 50%; background: radial-gradient(circle at 50% 45%, rgba(79,209,197,0.4), rgba(184,166,255,0.08)); border: 1.5px solid var(--turquoise); display: flex; align-items: center; justify-content: center; transform: scale(0.72); transition: transform 4s ease-in-out; }
      .pacer-label { font-size: 13.5px; color: var(--text); font-family: 'IBM Plex Mono', monospace; }
      .pacer.running.phase-inhale, .pacer.running.phase-hold1 { transform: scale(1); }
      .pacer.running.phase-exhale, .pacer.running.phase-hold2 { transform: scale(0.72); }
      .pacer-controls { display: flex; align-items: center; gap: 16px; }
      .btn-primary { display: flex; align-items: center; gap: 8px; background: linear-gradient(135deg, var(--turquoise), var(--lavender)); color: #16142B; font-weight: 700; padding: 10px 20px; border-radius: 999px; font-size: 14px; }
      .cycle-count { color: var(--muted); font-size: 13px; font-family: 'IBM Plex Mono', monospace; }
      .ripple-hint { color: var(--muted); font-size: 13px; align-self: flex-start; margin-top: -12px; }
      .ripple-pool { width: 100%; height: 200px; border-radius: 16px; background: var(--surface-alt); position: relative; overflow: hidden; cursor: crosshair; }
      .ripple { position: absolute; width: 12px; height: 12px; margin-left: -6px; margin-top: -6px; border-radius: 50%; background: var(--ripple-color); opacity: 0.55; animation: rippleOut 1.6s ease-out forwards; }
      @keyframes rippleOut { 0% { transform: scale(1); opacity: 0.55; } 100% { transform: scale(14); opacity: 0; } }
      .bubble-pool { width: 100%; height: 220px; border-radius: 16px; background: var(--surface-alt); position: relative; overflow: hidden; }
      .bubble { position: absolute; bottom: -60px; border-radius: 50%; animation-name: floatUp; animation-timing-function: linear; box-shadow: 0 0 16px -4px rgba(255,255,255,0.2); transition: transform 0.15s; }
      .bubble:hover { transform: scale(1.08); }
      .bubble:active { transform: scale(0.85); opacity: 0; }
      @keyframes floatUp { 0% { bottom: -60px; transform: translateX(0); } 50% { transform: translateX(14px); } 100% { bottom: 240px; transform: translateX(-10px); } }
      .confetti-layer { position: fixed; top: 30%; left: 50%; pointer-events: none; z-index: 60; }
      .confetti-piece { position: absolute; width: 8px; height: 8px; border-radius: 2px; opacity: 1; animation: confettiFly 1.2s ease-out forwards; }
      @keyframes confettiFly { 0% { transform: translate(0,0) rotate(0deg); opacity: 1; } 100% { transform: translate(var(--dx), var(--dy)) rotate(260deg); opacity: 0; } }
      @media (prefers-reduced-motion: reduce) { .ring, .ripple, .pacer, .blob, .bubble, .confetti-piece { animation: none !important; transition: none !important; } }
      @media (max-width: 780px) {
        .shell { flex-direction: column; }
        .sidebar { position: fixed; top: 56px; left: 0; right: 0; bottom: 0; transform: translateX(-100%); transition: transform 0.2s; z-index: 30; width: 100%; }
        .sidebar.open { transform: translateX(0); }
        .mobile-nav-toggle { display: flex; align-items: center; gap: 10px; position: sticky; top: 0; z-index: 20; width: 100%; background: var(--surface); border-bottom: 1px solid var(--border); padding: 16px 20px; font-size: 15px; color: var(--text); }
        .content { padding: 24px 20px 60px; }
        .hero h1 { font-size: 26px; }
        .breathing-ring { display: none; }
        .hero-blobs { opacity: 0.3; }
      }
    `}</style>
  );
        }
