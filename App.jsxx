      .week-bar-track { width: 100%; max-width: 26px; height: 70px; display: flex; align-items: flex-end; border-radius: 6px; overflow: hidden; background: var(--surface-alt); }
      .week-bar-fill { width: 100%; border-radius: 6px 6px 0 0; transition: height 0.3s; }
