      .stat-num { font-family: 'IBM Plex Mono', monospace; font-size: 26px; color: var(--accent); }
      .stat-label { color: var(--muted); font-size: 12.5px; margin-top: 2px; }
      .storage-warning { color: var(--sunflower); font-size: 13px; }
      .week-card h2, .badges-card h2 { font-size: 16px; margin-bottom: 16px; }
